# ── Copia este archivo como .env y ajusta los valores ─────────────────────────
# cp .env.example .env

# ── Base de datos — Supabase (PostgreSQL) ─────────────────────────────────────
# Pooler de transacciones (PgBouncer, puerto 6543) — para FastAPI / asyncpg
# Nota: caracteres especiales en la contraseña deben ser URL-encoded
#   % → %25 | $ → %24 | & → %26
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Pooler de sesiones (puerto 5432) — para scripts síncronos (batch_inference.py)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura_de_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── ML ────────────────────────────────────────────────────────────────────────
DATASET_PATH=data/processed/dataset_ml.csv
MODEL_PATH=data/processed/modelo_ncf.pt

# ── CORS ──────────────────────────────────────────────────────────────────────
# En producción: reemplazar * por el dominio del frontend
CORS_ORIGINS=http://localhost:3000
